# Copie para .env (o .env nunca é commitado).
# Token OPCIONAL do GitHub para fugir do limite público de 60 requisições/hora.
# Crie em https://github.com/settings/tokens (fine-grained, só leitura de repositórios públicos).
# Ele só é usado pelo scripts/fetch-github.ts em tempo de build: nunca vai para o navegador.
GITHUB_TOKEN=

# Opcional: sobrescreve o githubUser de src/content/projetos.config.ts
# GITHUB_USER=
